# Local development uses the already-running host PostgreSQL service.
# The project's local migration command only accepts ecommtemple_dev.
# Set real credentials in your shell or ignored backend/.env; never commit them.
DATABASE_URL=postgres://YOUR_PG_USER:YOUR_PASSWORD@localhost:5432/ecommtemple_dev?sslmode=disable
HTTP_ADDR=127.0.0.1:8080
